                        <div class="provider-rating-row" style="font-size:11.5px;color:var(--muted)">
                            📍 ${a.location || 'Adoor'} · <span style="color:#059669;font-weight:700">${a.type || '24x7 Ambulance'}</span>
                        </div>
                    </div>
                    <a href="tel:${a.phone}" class="call-emergency-btn" onclick="toast('Calling ${a.name}...')">
