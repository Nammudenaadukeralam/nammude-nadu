                function setHeroBannerStyle(url) {
            const heroWrap = document.querySelector('.hero-banner-wrap');
            const brandOverlay = document.getElementById('heroBrandOverlay');
            if (!heroWrap) return;

            if (!url || url.includes('kerala_hero_clean.png')) {
                heroWrap.style.backgroundImage = "url('assets/kerala_hero_clean.png')";
                if (brandOverlay) brandOverlay.style.display = 'none';
            } else {
                heroWrap.style.backgroundImage = "url('" + url + "')";
                if (brandOverlay) brandOverlay.style.display = 'flex';
            }
        }

        window.addEventListener('storage', (e) => {
            if (e.key === 'thuna_custom_hero_banner') {
                setHeroBannerStyle(e.newValue || 'assets/kerala_hero_clean.png');
            }
        });

        // =============================================================
        // MULTI-PHONE LIVE NETWORK SYNC ENGINE (2,000+ USERS REAL-TIME)
        // =============================================================
        function mergeById(localList, remoteList) {
            const map = new Map();
            for (const item of (remoteList || [])) {
                if (item && item.id) map.set(item.id, item);
            }
            for (const item of (localList || [])) {
                if (item && item.id && !map.has(item.id)) map.set(item.id, item);
            }
            return Array.from(map.values());
        }

        const ThunaSync = {
            isSyncing: false,
            async pull() {
                if (this.isSyncing) return;
                this.isSyncing = true;
                try {
                    const res = await fetch('/api/all', { cache: 'no-store' });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data) return;

                    // 1. Live Banner Sync
                    if (data.banner !== undefined) {
                        const cur = localStorage.getItem('thuna_custom_hero_banner') || '';
                        if (cur !== data.banner) {
                            localStorage.setItem('thuna_custom_hero_banner', data.banner);
                            setHeroBannerStyle(data.banner);
                        }
                    }

                    // 2. Live Ambulances Sync across all devices
                    if (Array.isArray(data.ambulances)) {
                        let localA = [];
                        try { localA = JSON.parse(localStorage.getItem('thuna_registered_ambulances') || '[]'); } catch(e){}
                        const mergedA = mergeById(localA, data.ambulances);
                        if (JSON.stringify(localA) !== JSON.stringify(mergedA)) {
                            localStorage.setItem('thuna_registered_ambulances', JSON.stringify(mergedA));
                            if (typeof renderAmbulancesList === 'function') renderAmbulancesList();
                        }
                    }

                    // 3. Live Jobs Sync
                    if (Array.isArray(data.jobs)) {
                        let localJ = [];
                        try { localJ = JSON.parse(localStorage.getItem('thuna_custom_jobs') || '[]'); } catch(e){}
                        const mergedJ = mergeById(localJ, data.jobs);
                        if (JSON.stringify(localJ) !== JSON.stringify(mergedJ)) {
                            localStorage.setItem('thuna_custom_jobs', JSON.stringify(mergedJ));
                            if (typeof renderJobs === 'function') renderJobs();
                        }
                    }

                    // 4. Live Blood Donors Sync
                    if (Array.isArray(data.donors)) {
                        let localD = [];
                        try { localD = JSON.parse(localStorage.getItem('thuna_custom_donors') || '[]'); } catch(e){}
                        const mergedD = mergeById(localD, data.donors);
                        if (JSON.stringify(localD) !== JSON.stringify(mergedD)) {
                            localStorage.setItem('thuna_custom_donors', JSON.stringify(mergedD));
                            if (typeof renderDonors === 'function') renderDonors();
                        }
                    }

                    // 5. Live Service Providers Sync
                    if (Array.isArray(data.providers)) {
                        let localP = [];
                        try { localP = JSON.parse(localStorage.getItem('thuna_custom_providers') || '[]'); } catch(e){}
                        const mergedP = mergeById(localP, data.providers);
                        if (JSON.stringify(localP) !== JSON.stringify(mergedP)) {
                            localStorage.setItem('thuna_custom_providers', JSON.stringify(mergedP));
                            if (typeof renderServices === 'function') renderServices();
                        }
                    }

                    // 6. Live Community Posts Sync
                    if (Array.isArray(data.posts)) {
                        let localPosts = [];
                        try { localPosts = JSON.parse(localStorage.getItem('thuna_custom_posts') || '[]'); } catch(e){}
                        const mergedPosts = mergeById(localPosts, data.posts);
                        if (JSON.stringify(localPosts) !== JSON.stringify(mergedPosts)) {
                            localStorage.setItem('thuna_custom_posts', JSON.stringify(mergedPosts));
                            if (typeof renderCommunityFeed === 'function') renderCommunityFeed();
                        }
                    }
                } catch(e) {
                } finally {
                    this.isSyncing = false;
                }
            },

            start() {
                this.pull();
                setInterval(() => this.pull(), 4000);
                window.addEventListener('focus', () => this.pull());
                document.addEventListener('visibilitychange', () => {
                    if (document.visibilityState === 'visible') this.pull();
                });
            }
        };
    </script>

