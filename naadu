            const seen = new Set();
            const unique = list.filter(a => {
                if (!a.phone || seen.has(a.phone)) return false;
                seen.add(a.phone);
                return true;
            });

            container.innerHTML = unique.map(a => `
                <div class="provider-card">
                    <div class="provider-avatar-circle" style="background:#fee2e2;color:#dc2626;font-size:20px;display:flex;align-items:center;justify-content:center">
