        function submitNewProvider() {
            const name = (document.getElementById('newProvName')?.value || '').trim();
            const cat = (document.getElementById('newProvCat')?.value || 'Electrician').trim().toLowerCase();
            const phone = (document.getElementById('newProvPhone')?.value || '').trim();
            const kws = (document.getElementById('newProvKeywords')?.value || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
            const desc = (document.getElementById('newProvDesc')?.value || '').trim();

            if (!name || !phone) {
                toast('⚠️ Please provide Business Name and Phone Number.');
                return;
            }

            const masterMatch = MASTER_CATEGORIES.find(c => c.name.toLowerCase() === cat || c.id === cat);
            const icon = masterMatch ? masterMatch.icon : '🛠️';
            const color = masterMatch ? masterMatch.color : '#059669';
            const bg = masterMatch ? masterMatch.bg : '#dcfce7';

            const newProv = {
                id: 'prov_custom_' + Date.now(),
                name: name,
                category: cat,
                rating: 5.0,
                reviews: 1,
                distance: '0.8 km',
                desc: (desc || `${cat.toUpperCase()} • Verified In-App Service`),
                phone: phone,
                color: color,
                bgColor: bg,
                icon: icon,
                keywords: [cat, ...kws]
            };

            const custom = JSON.parse(localStorage.getItem('thuna_custom_providers') || '[]');
            custom.unshift(newProv);
            localStorage.setItem('thuna_custom_providers', JSON.stringify(custom));

            // Persist custom keywords into community keyword dictionary (Palarudeyum Keywords)
            if (kws.length > 0) {
                try {
                    const storedKws = JSON.parse(localStorage.getItem('thuna_custom_keywords') || '[]');
                    kws.forEach(kw => {
                        if (kw && !storedKws.some(item => item.word.toLowerCase() === kw.toLowerCase())) {
                            storedKws.push({
                                word: kw,
                                cat: cat,
                                ml: name,
                                type: 'Provider Keyword'
                            });
                        }
                    });
                    localStorage.setItem('thuna_custom_keywords', JSON.stringify(storedKws));
                } catch (e) {
                    console.error('Error saving custom keywords:', e);
                }
            }

            fetch('/api/providers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newProv)
            }).catch(() => { });

            // Clear inputs
            const nInput = document.getElementById('newProvName'); if (nInput) nInput.value = '';
            const pInput = document.getElementById('newProvPhone'); if (pInput) pInput.value = '';
            const kInput = document.getElementById('newProvKeywords'); if (kInput) kInput.value = '';
            const dInput = document.getElementById('newProvDesc'); if (dInput) dInput.value = '';

            closeModal('modal-add-service');
            renderServices();
            toast('🎉 Registered! Your service is live with Chat-Only protection.');
        }

