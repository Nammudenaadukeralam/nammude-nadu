        function handleAmbulanceSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('regAmbName').value.trim();
            const phone = document.getElementById('regAmbPhone').value.trim();
            const type = document.getElementById('regAmbType').value;
            const location = document.getElementById('regAmbLocation').value.trim();
            const availability = document.getElementById('regAmbAvailability').value;

            if (!name || !phone) {
                toast('Please fill all required fields');
                return;
            }

            const newAmb = {
                id: 'amb_' + Date.now(),
                name,
                phone,
                type: `${type} · ${availability}`,
                location: location || 'Adoor',
                verified: true,
                registeredAt: new Date().toISOString()
            };

            if (typeof APP_STATE !== 'undefined') {
                if (!APP_STATE.ambulances) APP_STATE.ambulances = [];
                APP_STATE.ambulances.unshift(newAmb);
            }

            try {
                let saved = JSON.parse(localStorage.getItem('thuna_registered_ambulances') || '[]');
                saved.unshift(newAmb);
                localStorage.setItem('thuna_registered_ambulances', JSON.stringify(saved));
            } catch(err){}

            // Cloud sync (Firebase + REST fallback)
            if (window.FirebaseSync && typeof window.FirebaseSync.pushAmbulance === 'function') {
                window.FirebaseSync.pushAmbulance(newAmb);
            }
            fetch('/api/register-ambulance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newAmb)
            }).catch(() => {});

            renderAmbulancesList();
            closeModal('modal-register-ambulance');
            openModal('modal-ambulance');
            toast('🎉 ആംബുലൻസ് വിജയകരമായി രജിസ്റ്റർ ചെയ്തു! (Ambulance registered!)');
            document.getElementById('registerAmbulanceForm').reset();
        }

